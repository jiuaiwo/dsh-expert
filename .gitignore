node_modules
.DS_Store
*.log
package.json.bak.*
.mnemon/

# 运行时同步记录（seedData 写进数据目录的，不是名册内容；绝不能进包）
data/.t-team-snapshot.json
# 团队运行时状态目录（验证/调试时可能落在仓库内，绝不能进 git/包）
.agent-teams/

# 云端分发的中间产物：tar 包上传到 OBS 后即无用，绝不进 git（清单 data/roster.json 才进）
dist/

# WorkBuddy 同步的 ETag 快照（机器相关，不入库）
tools/.workbuddy-etags.json

# 打包前的 roster 备份（编排脚本自动生成，用完即弃）
data/roster.json.bak-before-pack
__pycache__/

# 附件下载标记（客户端 fetchAssets 下载后才写进**运行时**目录）。
# 2026-10-13：从 ~/.t-team 往仓库侧恢复附件时被 rsync 带进来 16 个 —— 它一旦随包发布，
# 播种到别的机器后客户端会拿着它误判「附件已下载」，而包里根本没有附件文件。
data/experts/**/.assets.json

# 凭证类文件绝不进仓库 / 绝不进 npm 包。
# 2026-10-06：WorkBuddy 专家包 invoice-verify-workbuddy 自带一个 .env，里面是真实的
# 阿里云 OSS AccessKey ID + Secret，被导入脚本原样复制进来，还被 GitHub 的 push protection
# 在推新仓库时当场拦下才暴露。mcp-config.json 用的本来就是 ${VAR} 占位符 —— 这类文件
# 属于使用者自己的配置，不该随包分发。
.env
.env.*
!.env.example
**/.env
**/.env.*
